generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  accountType  AccountType @default(student)
  aiCredits    Int         @default(0) // metered credits for AI data-analysis calls (recommend-test / interpret)
  projectCredits Int       @default(0) // one-off project unlocks purchased à la carte (pay-per-project)
  createdAt    DateTime    @default(now())

  ownedProjects        Project[]
  sites                Site[]
  collaborations       ProjectCollaborator[]
  sentInvites          CollaboratorInvite[]  @relation("InvitedBy")
  passwordResets       PasswordResetToken[]
  datasets             Dataset[]
  subscription         Subscription?
  transactions         PaymentTransaction[]
}

// The kind of account holder, chosen at signup. Drives the per-type subscription
// plans and the dashboard they see (students get a plain project dashboard;
// institution / research_group accounts also get Sites + a supervisor dashboard).
enum AccountType {
  student
  institution
  research_group
}

enum SubscriptionStatus {
  inactive
  trialing
  active
  past_due
  canceled
}

// A user's current plan. planCode references the static catalog in
// src/lib/billing/plans.ts; Paystack codes are populated once a paid plan is
// activated via checkout/webhook.
model Subscription {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  planCode                 String
  status                   SubscriptionStatus @default(inactive)
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackEmailToken       String?
  currentPeriodEnd         DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Ledger of Paystack transactions; `reference` is the idempotency key shared
// between the checkout-verify path and the webhook.
model PaymentTransaction {
  id            String   @id @default(cuid())
  userId        String
  reference     String   @unique
  planCode      String?
  purpose       String   @default("subscription") // subscription | project | ai_credits
  quantity      Int      @default(1) // project slots or AI credits granted on fulfilment
  amount        Int // kobo
  currency      String   @default("NGN")
  status        String // success | failed | pending
  paystackEvent String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A study centre / collection site for multicenter studies. Sites belong to a
// user (institution / research group account owner); sessions are tagged with the
// site they were collected at so the supervisor dashboard can break results down
// by centre. Online collection tags via a per-site `?site=<code>` link; offline
// imports pick a site in the upload dialog.
model Site {
  id          String   @id @default(cuid())
  userId      String
  name        String
  code        String   // short slug used in per-site collection links; unique per user
  location    String?
  principalInvestigator String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions TestSession[]

  @@unique([userId, code])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  shareToken  String   @unique @default(cuid())
  config      Json
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators ProjectCollaborator[]
  invites       CollaboratorInvite[]
  sessions      TestSession[]
  analysisResults AnalysisResult[]
  datasets      Dataset[]

  @@index([ownerId])
}

model Dataset {
  id              String   @id @default(cuid())
  ownerId         String
  projectId       String?            // set when uploaded inside a project; null = standalone
  name            String
  schema          Json               // Record<string, { type, label }>  (ColumnSchema)
  rows            Json?              // Record<string, unknown>[] — inline for small datasets
  rowsBlobUrl     String?            // Vercel Blob URL of rows JSON for large datasets
  computedColumns Json?              // ComputedColumnDef[] — re-applied on load for blob-backed datasets
  n               Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  analysisResults AnalysisResult[]

  @@index([ownerId])
  @@index([projectId])
}

model AnalysisResult {
  id          String   @id @default(cuid())
  projectId   String?
  datasetId   String?
  analysisKey String
  paramsHash  String
  result      Json
  createdAt   DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dataset Dataset? @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([projectId, analysisKey, paramsHash])
  @@unique([datasetId, analysisKey, paramsHash])
  @@index([projectId])
  @@index([datasetId])
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model CollaboratorInvite {
  id          String    @id @default(cuid())
  projectId   String
  inviteeEmail String
  token       String    @unique @default(cuid())
  invitedById String
  accepted    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
}

model TestSession {
  id            String    @id @default(cuid())
  projectId     String
  siteId        String?
  participantId String
  takerEmail    String
  takerAge      String
  takerHandedness String
  takerEducation  String
  startedAt     DateTime
  finishedAt    DateTime?
  consentGiven  Boolean   @default(false)
  demographics  Json?
  globalTLX     Json?
  customAnswers Json?
  clientSubmissionId String? @unique
  createdAt     DateTime  @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  blocks  TestBlock[]

  @@index([takerEmail])
  @@index([projectId])
  @@index([siteId])
}

model TestBlock {
  id            String   @id @default(cuid())
  sessionId     String
  blockIndex    Int
  stimulusType  String
  level         Int
  perLevelTLX   Json?

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trials  TestTrial[]

  @@index([sessionId])
}

model TestTrial {
  id            String  @id @default(cuid())
  blockId       String
  trialIndex    Int
  stimulus      String
  isPriming     Boolean
  expectedMatch Boolean?
  responded     Boolean
  responseYes   Boolean?
  rtMs          Float?
  correct       Boolean?
  onsetTs       Float

  block TestBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

// Legacy model kept for backwards compatibility
model Session {
  id            String    @id @default(cuid())
  participantId String
  startedAt     DateTime
  finishedAt    DateTime?
  config        Json
  consentGiven  Boolean   @default(false)
  consentTs     DateTime?
  demographics  Json?
  globalTLX     Json?
  customAnswers Json?
  clientSubmissionId String? @unique
  createdAt     DateTime  @default(now())

  blocks Block[]
}

model Block {
  id           String  @id @default(cuid())
  sessionId    String
  blockIndex   Int
  stimulusType String
  level        Int
  perLevelTLX  Json?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trials  Trial[]
}

model Trial {
  id            String  @id @default(cuid())
  blockId       String
  trialIndex    Int
  stimulus      String
  isPriming     Boolean
  expectedMatch Boolean?
  responded     Boolean
  responseYes   Boolean?
  rtMs          Float?
  correct       Boolean?
  onsetTs       Float

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)
}
