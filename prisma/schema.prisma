generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  accountType  AccountType @default(student)
  isAdmin      Boolean     @default(false) // platform admin (marketplace moderation + course authoring)
  aiCredits    Int         @default(0) // metered credits for AI data-analysis calls (recommend-test / interpret)
  projectCredits Int       @default(0) // one-off project unlocks purchased à la carte (pay-per-project)
  createdAt    DateTime    @default(now())

  ownedProjects        Project[]
  sites                Site[]
  collaborations       ProjectCollaborator[]
  sentInvites          CollaboratorInvite[]  @relation("InvitedBy")
  passwordResets       PasswordResetToken[]
  datasets             Dataset[]
  subscription         Subscription?
  transactions         PaymentTransaction[]
  consultantProfile    ConsultantProfile?
  clientBookings       ConsultationBooking[] @relation("ClientBookings")
  sentMessages         ConsultationMessage[]
  enrollments          Enrollment[]
  certificates         Certificate[]
  authoredCourses      Course[]              @relation("CourseAuthor")
}

// The kind of account holder, chosen at signup. Drives the per-type subscription
// plans and the dashboard they see (students get a plain project dashboard;
// institution / research_group accounts also get Sites + a supervisor dashboard).
enum AccountType {
  student
  institution
  research_group
}

enum SubscriptionStatus {
  inactive
  trialing
  active
  past_due
  canceled
}

// A user's current plan. planCode references the static catalog in
// src/lib/billing/plans.ts; Paystack codes are populated once a paid plan is
// activated via checkout/webhook.
model Subscription {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  planCode                 String
  status                   SubscriptionStatus @default(inactive)
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  paystackEmailToken       String?
  currentPeriodEnd         DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Ledger of Paystack transactions; `reference` is the idempotency key shared
// between the checkout-verify path and the webhook.
model PaymentTransaction {
  id            String   @id @default(cuid())
  userId        String
  reference     String   @unique
  planCode      String?
  purpose       String   @default("subscription") // subscription | project | ai_credits | consultation | course
  refId         String?  // booking id (consultation) or course id (course) this payment fulfils
  quantity      Int      @default(1) // project slots or AI credits granted on fulfilment
  amount        Int // kobo
  currency      String   @default("NGN")
  status        String // success | failed | pending
  paystackEvent String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A study centre / collection site for multicenter studies. Sites belong to a
// user (institution / research group account owner); sessions are tagged with the
// site they were collected at so the supervisor dashboard can break results down
// by centre. Online collection tags via a per-site `?site=<code>` link; offline
// imports pick a site in the upload dialog.
model Site {
  id          String   @id @default(cuid())
  userId      String
  name        String
  code        String   // short slug used in per-site collection links; unique per user
  location    String?
  principalInvestigator String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions TestSession[]

  @@unique([userId, code])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  shareToken  String   @unique @default(cuid())
  config      Json
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators ProjectCollaborator[]
  invites       CollaboratorInvite[]
  sessions      TestSession[]
  analysisResults AnalysisResult[]
  datasets      Dataset[]

  @@index([ownerId])
}

model Dataset {
  id              String   @id @default(cuid())
  ownerId         String
  projectId       String?            // set when uploaded inside a project; null = standalone
  name            String
  schema          Json               // Record<string, { type, label }>  (ColumnSchema)
  rows            Json?              // Record<string, unknown>[] — inline for small datasets
  rowsBlobUrl     String?            // Vercel Blob URL of rows JSON for large datasets
  computedColumns Json?              // ComputedColumnDef[] — re-applied on load for blob-backed datasets
  n               Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  analysisResults AnalysisResult[]

  @@index([ownerId])
  @@index([projectId])
}

model AnalysisResult {
  id          String   @id @default(cuid())
  projectId   String?
  datasetId   String?
  analysisKey String
  paramsHash  String
  result      Json
  createdAt   DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dataset Dataset? @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([projectId, analysisKey, paramsHash])
  @@unique([datasetId, analysisKey, paramsHash])
  @@index([projectId])
  @@index([datasetId])
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model CollaboratorInvite {
  id          String    @id @default(cuid())
  projectId   String
  inviteeEmail String
  token       String    @unique @default(cuid())
  invitedById String
  accepted    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
}

model TestSession {
  id            String    @id @default(cuid())
  projectId     String
  siteId        String?
  participantId String
  takerEmail    String
  takerAge      String
  takerHandedness String
  takerEducation  String
  startedAt     DateTime
  finishedAt    DateTime?
  consentGiven  Boolean   @default(false)
  demographics  Json?
  globalTLX     Json?
  customAnswers Json?
  clientSubmissionId String? @unique
  createdAt     DateTime  @default(now())

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  site    Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  blocks  TestBlock[]

  @@index([takerEmail])
  @@index([projectId])
  @@index([siteId])
}

model TestBlock {
  id            String   @id @default(cuid())
  sessionId     String
  blockIndex    Int
  stimulusType  String
  level         Int
  perLevelTLX   Json?

  session TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trials  TestTrial[]

  @@index([sessionId])
}

model TestTrial {
  id            String  @id @default(cuid())
  blockId       String
  trialIndex    Int
  stimulus      String
  isPriming     Boolean
  expectedMatch Boolean?
  responded     Boolean
  responseYes   Boolean?
  rtMs          Float?
  correct       Boolean?
  onsetTs       Float

  block TestBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Statistical consulting marketplace (two-sided). Users apply to become
// consultants; clients book paid sessions; each booking gets its own message
// thread + review; earnings are tracked as a payout ledger (disbursed
// off-platform for now).
// ─────────────────────────────────────────────────────────────────────────────
model ConsultantProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  headline             String
  bio                  String
  expertise            String[] // free-form tags, e.g. ["ANOVA", "SEM", "R"]
  hourlyRateKobo       Int
  currency             String   @default("NGN")
  yearsExperience      Int?
  status               String   @default("pending") // pending | approved | rejected | suspended
  payoutBankCode       String?
  payoutAccountNumber  String?
  payoutAccountName    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings ConsultationBooking[]
  payouts  ConsultantPayout[]

  @@index([status])
}

model ConsultationBooking {
  id                    String    @id @default(cuid())
  clientId              String
  consultantId          String    // → ConsultantProfile.id
  status                String    @default("requested") // requested | confirmed | paid | completed | cancelled
  scheduledAt           DateTime?
  durationMins          Int       @default(60)
  topic                 String
  message               String?
  datasetId             String?
  amountKobo            Int?
  platformFeeKobo       Int?
  consultantEarningsKobo Int?
  paymentReference      String?
  meetingUrl            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  client     User                   @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  consultant ConsultantProfile      @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  messages   ConsultationMessage[]
  review     ConsultationReview?

  @@index([clientId])
  @@index([consultantId])
}

model ConsultationMessage {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  booking ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model ConsultationReview {
  id        String   @id @default(cuid())
  bookingId String   @unique
  rating    Int      // 1–5
  comment   String?
  createdAt DateTime @default(now())

  booking ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model ConsultantPayout {
  id           String   @id @default(cuid())
  consultantId String
  amountKobo   Int
  status       String   @default("pending") // pending | paid
  note         String?
  createdAt    DateTime @default(now())

  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([consultantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Research training & certification (LMS). Admin-authored courses (modules →
// lessons) with an end-of-course quiz; enrollment (free or paid), lesson
// progress, and an auto-issued verifiable certificate.
// ─────────────────────────────────────────────────────────────────────────────
model Course {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  summary          String
  description      String
  coverImageUrl    String?
  level            String   @default("beginner")
  priceKobo        Int      @default(0) // 0 = free
  currency         String   @default("NGN")
  estimatedMinutes Int?
  status           String   @default("draft") // draft | published
  passThreshold    Int      @default(70) // quiz % needed to pass
  authorId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  author      User?          @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  modules     CourseModule[]
  quiz        QuizQuestion[]
  enrollments Enrollment[]
  certificates Certificate[]

  @@index([status])
}

model CourseModule {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int      @default(0)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id              String   @id @default(cuid())
  moduleId        String
  title           String
  order           Int      @default(0)
  contentMarkdown String
  videoUrl        String?
  durationMins    Int?

  module   CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId])
}

model QuizQuestion {
  id           String @id @default(cuid())
  courseId     String
  prompt       String
  options      Json   // string[]
  correctIndex Int
  order        Int    @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Enrollment {
  id               String    @id @default(cuid())
  userId           String
  courseId         String
  status           String    @default("active") // active | completed
  paymentReference String?
  enrolledAt       DateTime  @default(now())
  completedAt      DateTime?

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  attempts    QuizAttempt[]
  certificate Certificate?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model QuizAttempt {
  id           String   @id @default(cuid())
  enrollmentId String
  score        Int      // percentage 0–100
  passed       Boolean
  answers      Json     // number[] chosen option indices
  createdAt    DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

model Certificate {
  id           String   @id @default(cuid())
  enrollmentId String   @unique
  userId       String
  courseId     String
  serial       String   @unique // public verify code, e.g. NG-XXXX-XXXX
  issuedAt     DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Legacy model kept for backwards compatibility
model Session {
  id            String    @id @default(cuid())
  participantId String
  startedAt     DateTime
  finishedAt    DateTime?
  config        Json
  consentGiven  Boolean   @default(false)
  consentTs     DateTime?
  demographics  Json?
  globalTLX     Json?
  customAnswers Json?
  clientSubmissionId String? @unique
  createdAt     DateTime  @default(now())

  blocks Block[]
}

model Block {
  id           String  @id @default(cuid())
  sessionId    String
  blockIndex   Int
  stimulusType String
  level        Int
  perLevelTLX  Json?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trials  Trial[]
}

model Trial {
  id            String  @id @default(cuid())
  blockId       String
  trialIndex    Int
  stimulus      String
  isPriming     Boolean
  expectedMatch Boolean?
  responded     Boolean
  responseYes   Boolean?
  rtMs          Float?
  correct       Boolean?
  onsetTs       Float

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)
}
